# =============================================================
# JS CONSULTORES Y ABOGADOS – Valeria, asistente virtual de WhatsApp
# Copie este archivo como .env y complete los valores:  cp .env.example .env
# NUNCA suba el archivo .env al repositorio.
# =============================================================

# ---------- OBLIGATORIAS ----------

# Proveedor del LLM: "ollama" (local, sin costo) o "anthropic" (Claude, requiere ANTHROPIC_API_KEY).
LLM_PROVIDER=ollama

# Modelo local con Ollama. Ollama debe estar corriendo en el host.
# Candidatos a comparar con pruebas/evaluar_modelos.py: llama3:latest, qwen2.5:7b, llama3.1:8b.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest

# Meta for Developers > Su app > WhatsApp > Configuración de la API
# Token de acceso (el temporal vence en 24 h; para uso continuo, cree uno permanente con un usuario del sistema).
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
# Identificador del número de teléfono (no es el número en sí).
PHONE_NUMBER_ID=123456789012345

# Cadena secreta que usted inventa; debe ser idéntica a la que escriba en Meta > Webhooks > Token de verificación.
WEBHOOK_VERIFY_TOKEN=cambie-esto-por-un-token-largo-y-aleatorio

# Clave con la que n8n cifra sus credenciales. Genérela una vez (p. ej. `openssl rand -hex 32`) y no la cambie después.
N8N_ENCRYPTION_KEY=genere-una-clave-aleatoria-de-32-caracteres-o-mas

# URL pública de n8n. En pruebas locales, la URL HTTPS de ngrok (termina en /).
WEBHOOK_URL=https://xxxx-xx-xx.ngrok-free.app/

# ---------- OPCIONALES (tienen valores por defecto) ----------

# Ajustes de Ollama: contexto (system prompt + historial), tope de respuesta, creatividad y tiempo en memoria.
# El system prompt ocupa ~4.400 tokens: no baje OLLAMA_NUM_CTX de 8192 (con qwen2.5 o llama3.1 puede subirlo a 16384).
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=30m

# Anthropic (solo con LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tope de tokens por respuesta (incluye el razonamiento interno) y nivel de esfuerzo (low | medium | high).
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=low

# Versión de la Graph API de Meta.
META_API_VERSION=v21.0
# Secreto de la app (para validar la firma X-Hub-Signature-256; ver README > Seguridad).
META_APP_SECRET=

# Mensajes de historial por usuario y horas de inactividad antes de reiniciar la conversación.
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_TTL_HOURS=24
BUSINESS_TIMEZONE=America/Lima

# Versión vigente de la política de privacidad (Ley N.° 29733). Se guarda junto a cada consentimiento.
# Si la cambia, a quienes aceptaron una versión anterior se les vuelve a pedir el consentimiento.
POLICY_VERSION=2026-10

# ---------- REGISTRO Y AVISO DE CITAS ----------

# Clave AES-256 (32 bytes = 64 caracteres hex) con la que n8n cifra cada solicitud en datos/citas.jsonl.enc.
# Genérela una vez (ver README > Citas) y guárdela en un gestor de contraseñas: sin ella las citas son irrecuperables.
# Si está vacía o mal formada, las citas NO se guardan (el aviso al estudio lo indica).
CITAS_FILE_KEY=

# Número de WhatsApp del estudio que recibe un aviso SIN datos sensibles por cada solicitud nueva
# (solo dígitos, con código de país, p. ej. 51XXXXXXXXX). Vacío = sin aviso.
# Limitaciones: Meta solo entrega mensajes libres si ese número escribió a la línea en las últimas 24 h,
# y el número de prueba de Meta solo envía a destinatarios verificados.
FIRM_NOTIFY_WHATSAPP=

# Opcional: webhook que recibe la solicitud completa en JSON (Google Apps Script, Make, CRM...). Vacío = no se usa.
# Ojo: envía datos personales (nombre, teléfono, resumen) a ese servicio.
FIRM_NOTIFICATION_WEBHOOK_URL=
