# =============================================================
# JS CONSULTORES Y ABOGADOS – Valeria, asistente virtual de WhatsApp
# Copie este archivo como .env y complete los valores:  cp .env.example .env
# NUNCA suba el archivo .env al repositorio.
# =============================================================

# ---------- OBLIGATORIAS ----------

# Modelo local con Ollama (pruebas sin costo). Ollama debe estar corriendo en el host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Meta for Developers > Su app > WhatsApp > Configuración de la API
# Token de acceso (el temporal vence en 24 h; para uso continuo, cree uno permanente con un usuario del sistema).
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
# Identificador del número de teléfono (no es el número en sí).
PHONE_NUMBER_ID=123456789012345

# Cadena secreta que usted inventa; debe ser idéntica a la que escriba en Meta > Webhooks > Token de verificación.
WEBHOOK_VERIFY_TOKEN=cambie-esto-por-un-token-largo-y-aleatorio

# Clave con la que n8n cifra sus credenciales. Genérela una vez (p. ej. `openssl rand -hex 32`) y no la cambie después.
N8N_ENCRYPTION_KEY=genere-una-clave-aleatoria-de-32-caracteres-o-mas

# URL pública de n8n. En pruebas locales, la URL HTTPS de ngrok (termina en /).
WEBHOOK_URL=https://xxxx-xx-xx.ngrok-free.app/

# ---------- OPCIONALES (tienen valores por defecto) ----------

# Ajustes de Ollama: contexto (system prompt + historial), tope de respuesta, creatividad y tiempo en memoria.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=30m

# Anthropic (no se usa en la versión con Ollama; se conserva para volver a Claude en producción).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Versión de la Graph API de Meta.
META_API_VERSION=v21.0
# Secreto de la app (para validar la firma X-Hub-Signature-256; ver README > Seguridad).
META_APP_SECRET=

# Mensajes de historial por usuario y horas de inactividad antes de reiniciar la conversación.
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_TTL_HOURS=24
BUSINESS_TIMEZONE=America/Lima

# Webhook que recibe las solicitudes de cita (Google Apps Script, Make, CRM, etc.). Vacío = no se notifica.
FIRM_NOTIFICATION_WEBHOOK_URL=
